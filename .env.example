NEXT_PUBLIC_APP_NAME="RepairQuote Check"
NEXT_PUBLIC_BASE_URL=https://repairquote-check.sensifai.com
SENSIFAI_GATEKEEPER_URL=https://gatekeeper.sensifai.com

# Dedicated Sensifai API Key & Price Model
SENSIFAI_API_KEY=
